[Unit]
Description=Retry isolated Technocore DID registry publication
ConditionPathExists=%h/flop-agent/flop_agent_identity.json
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/flop-agent
ExecStart=/usr/bin/python3 %h/flop-agent/registry-retry.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6
