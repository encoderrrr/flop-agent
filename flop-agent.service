[Unit]
Description=Isolated Technocore FLOP agent check-in
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/flop-agent
ExecStart=/usr/bin/python3 %h/flop-agent/agent.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/flop-agent
RestrictAddressFamilies=AF_INET AF_INET6
